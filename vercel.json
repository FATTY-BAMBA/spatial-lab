{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": { "api/render.js": { "maxDuration": 60 } },
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
